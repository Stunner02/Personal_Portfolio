{
  "name": "personal_portfolio",
  "version": "1.0.0",
  "description": "This repository contains the source code for my personal portfolio website: 👉 [gavglynn.com](https://gavglynn.com)",
  "main": "index.js",
  "scripts": {
    "sass:home": "sass --watch scss/pages/home/_index.scss       public/03_css/home.css      --quiet",
    "sass:projects": "sass --watch scss/pages/projects/_index.scss   public/03_css/projects.css  --quiet",
    "sass:about": "sass --watch scss/pages/about/_index.scss      public/03_css/about.css     --quiet",
    "sass:contact": "sass --watch scss/pages/contact/_index.scss    public/03_css/contact.css   --quiet",
    "sass:404": "sass --watch scss/pages/404/_index.scss        public/03_css/404.css       --quiet",
    "sass:shapeMemoryAlloy": "sass --watch scss/pages/shapeMemoryAlloy/_index.scss        public/03_css/shapeMemoryAlloy.css       --quiet",
    "dev:banner": "node -e \"console.log('sass compiled & watching: projects, home, 404, about, contact  |  Press Ctrl-C to stop')\"",
    "dev:vite": "vite",
    "dev:sass": "npm-run-all -p sass:*",
    "dev": "npm-run-all --silent dev:banner -p dev:vite dev:sass",
    "build:sass": "npm-run-all sass:* --parallel=false",
    "build:vite": "vite build",
    "build": "npm-run-all build:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stunner02/Personal_Portfolio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Stunner02/Personal_Portfolio/issues"
  },
  "homepage": "https://github.com/Stunner02/Personal_Portfolio#readme",
  "dependencies": {
    "reveal.js": "^5.2.1",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "vite": "^6.3.5"
  }
}
